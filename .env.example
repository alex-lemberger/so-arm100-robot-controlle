# Local Ollama server settings.
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="ornith:9b"

# Optional raw safety commands for your robot controller. Leave blank until you
# have verified the exact controller protocol; these values are sent as-is.
VITE_ESTOP_COMMAND=""
VITE_TORQUE_ENABLE_COMMAND=""
VITE_TORQUE_DISABLE_COMMAND=""

# Direct WebSerial safety: physical motion stays locked until all six STS3215
# servos reply to a non-motion verification scan and this exact per-joint
# calibration is supplied. minTick/maxTick correspond to the UI joint limits
# in src/constants.ts; include the matching homingOffset recorded by LeRobot.
# Never copy these placeholder values to a real robot — record its own limits.
# VITE_FEETECH_CALIBRATION='{"base":{"minTick":0,"maxTick":0,"homingOffset":0},"shoulder":{"minTick":0,"maxTick":0,"homingOffset":0},"elbow":{"minTick":0,"maxTick":0,"homingOffset":0},"wristPitch":{"minTick":0,"maxTick":0,"homingOffset":0},"wristRoll":{"minTick":0,"maxTick":0,"homingOffset":0},"gripper":{"minTick":0,"maxTick":0,"homingOffset":0}}'

# Optional passive leader-arm encoder reads. Use the separate calibration for
# this exact leader arm, never the follower calibration. The app verifies these
# registers with PING/READ only before it enables leader telemetry or mirroring.
# VITE_LEADER_FEETECH_CALIBRATION='{"base":{"minTick":0,"maxTick":0,"homingOffset":0},"shoulder":{"minTick":0,"maxTick":0,"homingOffset":0},"elbow":{"minTick":0,"maxTick":0,"homingOffset":0},"wristPitch":{"minTick":0,"maxTick":0,"homingOffset":0},"wristRoll":{"minTick":0,"maxTick":0,"homingOffset":0},"gripper":{"minTick":0,"maxTick":0,"homingOffset":0}}'

# APP_URL: The URL where this app is hosted.
APP_URL="MY_APP_URL"
